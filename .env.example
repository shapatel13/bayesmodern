PRIORI_ENV=development
PRIORI_APP_NAME=PRIORI-X
PRIORI_LOG_LEVEL=INFO
PRIORI_SAFETY_MODE=conservative
PRIORI_ALLOW_LIVE_LLM=false
PRIORI_DEFAULT_MODEL_PROVIDER=openai
PRIORI_DEFAULT_REASONER=hybrid-bayesian
PRIORI_REDACT_TRACES=true
PRIORI_TRACE_RETENTION_DAYS=30
PRIORI_SEED=17
PRIORI_EXPERIMENT_NAMESPACE=local-dev
PRIORI_MECHANISM_DAG_ENABLED=true
PRIORI_MIETIC_PATH=
PRIORI_N2C2_2018_TRACK2_PATH=
PRIORI_MEDVAL_BENCH_PATH=
PRIORI_REVIEWED_CASES_PATH=
PRIORI_OPENAI_PARSER_MODEL=gpt-5.4-nano-2026-03-17
PRIORI_OPENAI_REASONING_MODEL=gpt-5.4-nano-2026-03-17
PRIORI_OPENAI_VERIFIER_MODEL=gpt-5.4-nano-2026-03-17
PRIORI_OPENAI_CASE_REVIEW_MODEL=gpt-5.4

# Optional external providers. Leave blank unless you are running explicit offline experiments.
# Optional credential-gated benchmark exports should be set to local CSV/JSON/JSONL paths or directories.
OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
